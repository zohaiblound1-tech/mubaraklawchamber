# Neon PostgreSQL connection string (pooled). Leave empty to use the embedded
# local database in ./.local-db during development.
DATABASE_URL=

# Vercel Blob read/write token. Leave empty to store uploads in ./public/uploads
# during development.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in password and the secret used to sign session cookies (32+ chars).
ADMIN_PASSWORD=
SESSION_SECRET=
